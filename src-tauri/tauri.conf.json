{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MailHub",
  "version": "0.2.0",
  "identifier": "com.mailhub.desktop",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": ["settings-window"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "label": "settings",
        "title": "Connect to MailHub",
        "width": 620,
        "height": 620,
        "minWidth": 500,
        "minHeight": 560,
        "resizable": true,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "shortDescription": "MailHub desktop client",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
